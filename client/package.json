{
  "name": "localcrag-client",
  "version": "1.72.1",
  "scripts": {
    "ng": "ng",
    "tw:build": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css",
    "tw:watch": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.generated.css --watch",
    "start": "npm run tw:build && ng serve",
    "dev": "npm run tw:build && concurrently -k -n tw,ng \"npm run tw:watch\" \"ng serve\"",
    "build": "npm run tw:build && ng build",
    "watch": "npm run tw:build && concurrently -k -n tw,ng \"npm run tw:watch\" \"ng build --watch --configuration development\"",
    "test": "npm run tw:build && ng test",
    "test:ci": "npm run tw:build && ng test --watch=false --coverage",
    "i18n:extract": "transloco-keys-manager extract -d \"\" -l de en fr it nl -R",
    "i18n:find": "transloco-keys-manager find",
    "e2e:run-test-backend": "cd ../server/src && export PYTHONPATH=. && export LOCALCRAG_CONFIG=config/test-ci-e2e.cfg && pipenv run flask run",
    "e2e:headless": "cd ../scripts && bash run-playwright-with-dependencies.sh",
    "e2e": "cd ../scripts && PLAYWRIGHT_MODE=ui bash run-playwright-with-dependencies.sh",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "postinstall": "playwright install chromium",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org localcrag --project localcrag-client ./dist/client && sentry-cli sourcemaps upload --org localcrag --project localcrag-client ./dist/client",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@lexical/history": "^0.53.0",
    "@lexical/html": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/utils": "^0.53.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@sentry/angular": "^10.78.0",
    "@spartan-ng/brain": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/angular-charts": "0.16.0",
    "@tanstack/charts": "0.16.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-de": "^4.1.1",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-fr": "^4.1.2",
    "@zxcvbn-ts/language-it": "^4.1.1",
    "chart.js": "^4.4.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.3.1",
    "dexie": "^4.4.4",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^22.0.0",
    "konva": "^9.3.18",
    "lexical": "^0.53.0",
    "maplibre-gl": "^5.1.1",
    "ngx-colors": "^4.0.2",
    "ngx-infinite-scroll": "^22.0.0",
    "ngx-mapbox-gl": "^14.0.0",
    "ngx-matomo-client": "^10.0.0",
    "ngx-scrollbar": "^19.1.5",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^9.39.5",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "^2.42.2",
    "@spartan-ng/cli": "^1.9.0",
    "@tailwindcss/cli": "^4.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "concurrently": "^9.2.3",
    "eslint": "^9.38.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.10.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "**/*.{js,ts,html}": [
      "prettier --write .",
      "eslint"
    ],
    "**/*.scss": [
      "prettier --write ."
    ],
    "src/assets/i18n/**/*.{json}": [
      "prettier --write ."
    ]
  }
}
