# Prefix for the Docker Compose project
COMPOSE_PROJECT_NAME=localcrag

# Database configuration
POSTGRES_USER=localcrag
POSTGRES_DB=localcrag
POSTGRES_PASSWORD=

# Storage configuration
S3_USER=
S3_BUCKET=localcrag
S3_PASSWORD=
S3_ACCESS_ENDPOINT=
# Object storage the server reads and writes. Defaults to MinIO
# (http://storage:9000), which is discontinued but still ships so existing
# installations keep their data. Fresh installations can point this at
# SeaweedFS immediately; existing ones must copy their objects over first.
# See docs/docker-compose-installation.md#migrating-from-minio-to-seaweedfs
#S3_ENDPOINT=http://seaweedfs:8333

# Server configuration
SUPERADMIN_FIRSTNAME=
SUPERADMIN_LASTNAME=
SUPERADMIN_EMAIL=
SECRET_KEY=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SYSTEM_EMAIL=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_TYPE=
FRONTEND_HOST=

# Watchtower configuration (optional)
WATCHTOWER_SCHEDULE="0 0 4 * * *"
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_NOTIFICATION_REPORT=true
WATCHTOWER_MONITOR_ONLY=false
